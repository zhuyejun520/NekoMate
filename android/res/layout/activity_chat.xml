<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/chat_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/chat_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="聊天"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/muted"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <ListView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:scrollbars="none"
            android:transcriptMode="normal" />

        <TextView
            android:id="@+id/typing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingBottom="4dp"
            android:text="对方正在输入…"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/voice_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:text="正在录音…"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="8dp">

            <com.nekocyte.companion.LineIconView
                android:id="@+id/voice_toggle"
                android:layout_width="36dp"
                android:layout_height="42dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="41dp"
                android:layout_marginLeft="2dp"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:background="@drawable/bg_input"
                    android:hint="说点什么…"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/hold_talk"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="按住 说话"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <com.nekocyte.companion.LineIconView
                android:id="@+id/pick_sticker"
                android:layout_width="36dp"
                android:layout_height="42dp" />

            <FrameLayout
                android:id="@+id/action_slot"
                android:layout_width="62dp"
                android:layout_height="42dp">

                <com.nekocyte.companion.LineIconView
                    android:id="@+id/toolbar_toggle"
                    android:layout_width="36dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center" />

                <Button
                    android:id="@+id/send"
                    android:layout_width="58dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_btn"
                    android:text="发送"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/bg"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/toolbar_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_soft"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
