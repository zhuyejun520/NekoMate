# ===== NekoMate 服务端环境变量示例 =====
# 复制为 .env 后按需修改（docker-compose 也可以直接在 environment 里写）

# 数据目录（数据库、上传文件、插件都在这里）
NM_DATA_DIR=/data

# 监听端口
NM_PORT=8080

# 对外访问地址（写入上传文件返回的 URL）
NM_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 管理员默认账号（首次启动自动创建）
NM_ADMIN_USERNAME=admin
NM_ADMIN_PASSWORD=change-me-now

# 是否开放注册
NM_REGISTRATION_ENABLED=true
NM_AUTO_CREATE_AI_FRIEND=true

# 登录 token 有效期（小时）
NM_TOKEN_TTL_HOURS=720

# 默认定时参数
NM_DEFAULT_IDLE_MINUTES=30
NM_DEFAULT_PROACTIVE_MIN_MINUTES=60
NM_DEFAULT_PROACTIVE_MAX_MINUTES=180
NM_DEFAULT_PROACTIVE_MAX_STREAK=3
NM_DEFAULT_SHORT_MEMORY_DAYS=2

# 跨域（客户端不需要跨域，浏览器调试可设 *）
NM_CORS_ORIGINS=*

# 时区
TZ=Asia/Shanghai
